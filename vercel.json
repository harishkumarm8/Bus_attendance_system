{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/css/(.*)",    "dest": "/css/$1" },
    { "src": "/js/(.*)",     "dest": "/js/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/index.html",  "dest": "/index.html" },
    { "src": "/",            "dest": "/index.html" },
    { "src": "/(.*\\.php)(.*)", "dest": "/$1$2" },
    { "src": "/(.*)",        "dest": "/login.php" }
  ]
}
